PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/wallet_db

# The two signing secrets are generated locally by setup.sh and are deliberately left
# blank here. A committed value here would be a key that every clone shares, so the names
# are documented and the values are not. setup.sh fills these two in on first run and
# leaves them alone on every run after that.
DJANGO_SECRET_KEY=
JWT_SECRET=

JWT_EXPIRES_IN=24h
